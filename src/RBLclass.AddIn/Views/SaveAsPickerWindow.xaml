<Window x:Class="RBLclass.AddIn.Views.SaveAsPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:RBLclass.AddIn.Localization"
        Title="{loc:Loc Key=SaveAsPicker_Title}"
        Height="320" Width="560"
        WindowStartupLocation="CenterOwner" MinHeight="220" MinWidth="400"
        d:DesignHeight="320" d:DesignWidth="560">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=SaveAsPicker_Save_Button}"
                    IsDefault="True" Padding="18,4" Click="Save_Click"
                    IsEnabled="{Binding HasTarget}" />
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=SaveAsPicker_Cancel_Button}"
                    IsCancel="True" Padding="18,4" Margin="0,0,8,0" Click="Cancel_Click" />
        </DockPanel>

        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc Key=SaveAsPicker_Intro}"
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{loc:Loc Key=AttachDisp_Browse_Button}"
                        Padding="8,2" Margin="6,0,0,0" Click="Browse_Click" />
                <TextBox Text="{Binding FavoriteQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Loc Key=AttachDisp_SearchHint}" />
            </DockPanel>
            <ListBox ItemsSource="{Binding FavoriteResults}" MaxHeight="140" Margin="0,4,0,0"
                     SelectionChanged="FavoriteResult_SelectionChanged"
                     Background="{DynamicResource Theme.ControlBackground}"
                     BorderBrush="{DynamicResource Theme.ControlBorder}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12"
                                   Foreground="{DynamicResource Theme.Foreground}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Margin="0,8,0,0" Background="{DynamicResource Theme.SelectionBackground}"
                    CornerRadius="3" Padding="6,4"
                    Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="{loc:Loc Key=AttachDisp_TargetPrefix}" FontWeight="Bold" />
                    <Hyperlink Click="TargetDirectory_Click"
                               Foreground="{DynamicResource Theme.Foreground}"
                               ToolTip="{loc:Loc Key=AttachDisp_OpenFolder_ToolTip}">
                        <Run Text="{Binding TargetDirectory}" />
                    </Hyperlink>
                </TextBlock>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
