<UserControl x:Class="RBLclass.AddIn.Views.AttachmentFolderPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RBLclass.AddIn.Localization">
    <!-- One folder picker for the attachment disposition modal (v2.11.0.0 C1):
         favourite-folder search, Browse, and the chosen folder. The DataContext
         is a SaveAsPickerViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <StackPanel>
        <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="{loc:Loc Key=AttachDisp_Browse_Button}"
                    Padding="8,2" Margin="6,0,0,0" Click="Browse_Click" />
            <TextBox Text="{Binding FavoriteQuery, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{loc:Loc Key=AttachDisp_SearchHint}" />
        </DockPanel>
        <ListBox ItemsSource="{Binding FavoriteResults}" MaxHeight="140" Margin="0,4,0,0"
                 SelectionChanged="FavoriteResult_SelectionChanged"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Background" Value="{DynamicResource Theme.ControlBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.ControlBorder}" />
                    <Style.Triggers>
                        <Trigger Property="HasItems" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Margin="0,4,0,0" Background="{DynamicResource Theme.SelectionBackground}"
                CornerRadius="3" Padding="6,4"
                Visibility="{Binding HasTarget, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap">
                <Run Text="{loc:Loc Key=AttachDisp_TargetPrefix}" FontWeight="Bold" />
                <Hyperlink Click="TargetDirectory_Click"
                           Foreground="{DynamicResource Theme.Foreground}"
                           ToolTip="{loc:Loc Key=AttachDisp_OpenFolder_ToolTip}">
                    <Run Text="{Binding TargetDirectory, Mode=OneWay}" />
                </Hyperlink>
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
