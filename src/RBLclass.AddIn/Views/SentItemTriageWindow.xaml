<Window x:Class="RBLclass.AddIn.Views.SentItemTriageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:RBLclass.AddIn.Localization"
        Title="{loc:Loc Key=SentTriage_Title}" Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        d:DesignHeight="300" d:DesignWidth="380">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontWeight="Bold" TextWrapping="Wrap"
                   Text="{loc:Loc Key=SentTriage_Question}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,8" Style="{DynamicResource MutedText}"
                   Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2" VerticalAlignment="Top">
            <Button Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch" Command="{Binding MoveToInboxCommand}">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Loc Key=SentTriage_MoveToInbox_Button}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch" Command="{Binding CopyToInboxCommand}">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Loc Key=SentTriage_CopyToInbox_Button}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch" Command="{Binding DeleteCommand}">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Loc Key=SentTriage_Delete_Button}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Margin="0,0,0,4" Padding="8,6" HorizontalAlignment="Stretch" Command="{Binding LeaveCommand}">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{loc:Loc Key=SentTriage_Leave_Button}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Margin="0" Padding="8,6" HorizontalAlignment="Stretch"
                    IsEnabled="{Binding HasArchiveFolder}" Command="{Binding MoveToArchiveCommand}">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Text="{Binding MoveToArchiveButtonLabel}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
