<UserControl x:Class="RBLclass.AddIn.Views.AttachmentGroupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:RBLclass.AddIn.Localization"
             xmlns:views="clr-namespace:RBLclass.AddIn.Views">
    <!-- Grouped view of the attachment disposition modal (v2.11.0.0 C1): one
         action and one folder for every attachment that is not pinned. The
         DataContext is the AttachmentDispositionViewModel. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{loc:Loc Key=AttachDisp_Delete_Radio}"
                             IsChecked="{Binding Group.IsDelete}" VerticalAlignment="Center" />
                <RadioButton Content="{loc:Loc Key=AttachDisp_SaveTo_Radio}"
                             IsChecked="{Binding Group.IsSaveTo}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <RadioButton Content="{loc:Loc Key=AttachDisp_Keep_Radio}"
                             IsChecked="{Binding Group.IsKeep}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="20,4,0,0"
                        Visibility="{Binding Group.IsSaveTo, Converter={StaticResource BoolToVis}}">
                <views:AttachmentFolderPicker DataContext="{Binding Group.Picker}" />
                <TextBlock Margin="0,4,0,0" Style="{DynamicResource MutedText}"
                           Text="{loc:Loc Key=AttachDisp_Group_NoFolder}"
                           Visibility="{Binding Group.ShowNoFolder, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding GroupCountText}" FontWeight="Bold" Margin="0,4,0,2" />

        <ListBox ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource Theme.ControlBorder}" BorderThickness="0,0,0,1" Padding="2,4">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}"
                                       Style="{DynamicResource MutedText}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                            <!-- A pinned row keeps its own action: show it. -->
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontStyle="Italic"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Theme.MutedForeground}" />
                                        <Setter Property="Text" Value="{loc:Loc Key=AttachDisp_SaveTo_Radio}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDelete}" Value="True">
                                                <Setter Property="Text" Value="{loc:Loc Key=AttachDisp_Delete_Radio}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeep}" Value="True">
                                                <Setter Property="Text" Value="{loc:Loc Key=AttachDisp_Keep_Radio}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding MailSubject}" Style="{DynamicResource MutedText}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
